      "description": "Connected nodes for an actual project workflow.",
      "html": "<section class=\"ds-canvas\"><h3>Real estate, connected.</h3><ol class=\"ds-flow\"><li>Host / API</li><li>CQRS handlers</li><li>Domain modules</li><li>SQL Server</li></ol></section>",
      "css": ".ds-canvas{background:#c9b6ed;color:#2b1a44;border-radius:16px;padding:30px 35px 24px;font-family:\"DM Sans\",sans-serif}.ds-canvas h3{font-size:30px;font-weight:500;letter-spacing:-.03em;margin:0}.ds-flow{display:flex;gap:35px;list-style:none;padding:0;margin:65px 0;position:relative}.ds-flow:before{content:\"\";position:absolute;left:10px;right:10px;top:50%;height:1px;background:#775b9b}.ds-flow li{position:relative;flex:1;background:#e9dff9;border:1px solid #775b9b;border-radius:12px;text-align:center;padding:27px 10px;font-size:18px}@media(max-width:650px){.ds-flow{flex-direction:column;gap:19px;margin:28px 0}.ds-flow:before{width:1px;left:50%;top:10px;bottom:10px;height:auto}.ds-flow li{padding:15px;font-size:16px}}"

      "html": "<button class=\"ds-theme\" aria-label=\"Switch to light mode\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\"><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5\"/></svg>Light</button>",
      "css": ".ds-theme{display:flex;align-items:center;gap:10px;min-height:44px;padding:9px 14px;border:1px solid var(--line,#3b3544);border-radius:12px;background:transparent;color:var(--text,#f3f0f7);font:13px \"DM Sans\",sans-serif;cursor:pointer}.ds-theme:hover{border-color:var(--accent,#c7b1f4)}.ds-theme:focus-visible{outline:2px solid var(--focus,#d5c2fa);outline-offset:5px}"

  "narrative": {
    "northStar": "Connected work, clearly presented",
    "overview": "Charcoal ground, lavender accents, flat geometry, quiet navigation and crisp self-hosted typography make real backend work readable. Open space and a restrained hierarchy give names, roles and workflows room to stand on their own.\n\nThe light theme translates the same relationships into pale paper and deep violet. Project exhibits keep their own fixed palettes so diagrams stay coherent across both themes.",
    "keyCharacteristics": [
      "Open spacing and large, medium-weight typography.",
      "Flat, softly rounded workflow exhibits.",
      "Clear theme-aware controls and visible keyboard focus."
    ],
    "rules": [
      {
        "name": "The Theme Relationship Rule",
        "body": "Use theme tokens for page content and controls; preserve fixed project palettes within their exhibits.",
        "section": "colors"
      },
      {
        "name": "The One Family Rule",
        "body": "Keep text and numeric scores in DM Sans; reserve monospace for literal code symbols.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use tonal contrast and borders to distinguish surfaces without adding shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve theme relationships and visible keyboard focus.",
      "Do use connected nodes to make actual workflows readable.",
      "Do keep numeric game scores in DM Sans with tabular numerals.",
      "Do adapt diagrams and columns to a single mobile reading order."
    ],
    "donts": [
      "Don't add shadows to these flat surfaces.",
      "Don't introduce another display family into this system.",
      "Don't substitute invented metrics or decorative code for verified project content."
    ]
  }
}

      "html": "<button class=\"ds-primary\">Explore my work <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\"><path d=\"M12 4v16m-6-6 6 6 6-6\"/></svg></button>",
